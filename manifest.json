{
  "manifest_version": 3,
  "name": "Mafsar — AI Chat to Quiz",
  "version": "0.2.0",
  "description": "Capture your AI chat learning sessions and turn them into flashcards, quizzes, and spaced-repetition reviews so you don't forget.",
  "permissions": [
    "storage",
    "activeTab",
    "sidePanel",
    "scripting",
    "notifications",
    "contextMenus",
    "tabs"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://mafsar-production.up.railway.app/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "scripts": [
      "src/background/service-worker.js"
    ],
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/ui/panel.html"
  },
  "sidebar_action": {
    "default_panel": "src/ui/panel.html",
    "default_title": "Mafsar",
    "default_icon": "icons/icon48.png"
  },
  "action": {
    "default_title": "Open Mafsar panel",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "src/content/adapters/adapter.js",
        "src/content/adapters/chatgpt.js",
        "src/content/adapters/claude.js",
        "src/content/adapters/gemini.js",
        "src/storage/last-answer.js",
        "src/content/capture.js"
      ],
      "css": [
        "src/content/capture.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://quizlet.com/*"
      ],
      "js": [
        "src/content/quizlet-import.js"
      ],
      "css": [
        "src/content/capture.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mafsar-production.up.railway.app/*"
      ],
      "js": [
        "src/content/landing.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "mafsar@sardorjumamuratov",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "personallyIdentifyingInfo",
          "websiteContent"
        ],
        "optional": []
      }
    }
  }
}
