# Server config — copy to .env and fill in
PORT=8787

# Secret used to sign JWTs (generate: openssl rand -hex 32)
JWT_SECRET=change-me

# SQLite file path (dev). For hosting, swap db.ts to libSQL/Turso and set:
# DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Phase 2 — LLM proxy
LLM_PROVIDER=gemini
LLM_API_KEY=
