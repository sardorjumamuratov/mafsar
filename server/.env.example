# Server config — copy to .env and fill in
PORT=8787

# Secret used to sign JWTs (generate: openssl rand -hex 32)
JWT_SECRET=change-me

# Database. Local dev defaults to a file (file:mafsar.db); production uses Turso:
# TURSO_DATABASE_URL=libsql://mafsar-<org>.turso.io
# TURSO_AUTH_TOKEN=<turso db tokens create mafsar>

# Phase 2 — LLM proxy
LLM_PROVIDER=gemini
LLM_API_KEY=
