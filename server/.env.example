# Server config — copy to .env and fill in
PORT=8787

# Secret used to sign JWTs (generate: openssl rand -hex 32)
JWT_SECRET=change-me

# Database. Local dev defaults to a file (file:mafsar.db); production uses Turso:
# TURSO_DATABASE_URL=libsql://mafsar-<org>.turso.io
# TURSO_AUTH_TOKEN=<turso db tokens create mafsar>

# Phase 2 — LLM proxy
LLM_PROVIDER=gemini
LLM_API_KEY=

# Google sign-in. Optional — omit both and the feature just returns
# "unavailable" to the client instead of erroring. From Google Cloud Console:
# APIs & Services -> Credentials -> OAuth client ID -> Web application, with
# this redirect URI registered exactly: <your-domain>/v1/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Only needed if the deployed domain differs from the hardcoded default
# (mafsar-production.up.railway.app):
# GOOGLE_REDIRECT_URI=

# Stripe billing ("Mafsar Pro"). Optional — omit all three and the feature
# just returns "unavailable" to the client. From the Stripe Dashboard:
# Product catalog -> a recurring monthly Price -> STRIPE_PRICE_ID;
# Developers -> API keys -> STRIPE_SECRET_KEY;
# Developers -> Webhooks -> an endpoint at <your-domain>/v1/webhooks/stripe
# listening for checkout.session.completed, customer.subscription.updated,
# and customer.subscription.deleted -> its signing secret -> STRIPE_WEBHOOK_SECRET.
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID=
# STRIPE_WEBHOOK_SECRET=

# Required in production once billing is enabled — Stripe's post-checkout
# redirect otherwise falls back to the request's own Host header, which a
# spoofed header could point at an attacker's domain.
# PUBLIC_BASE_URL=https://mafsar-production.up.railway.app

# Free-tier cap on metered AI calls (set generation, grading, coding tasks) per
# calendar month; Pro accounts are uncapped. Defaults to 30 if unset.
# FREE_MONTHLY_GENERATIONS=30
